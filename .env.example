# Leeg laten = Keystatic bewerkt lokale bestanden (npm run dev).
# Invullen = Keystatic leest/schrijft via GitHub (commits/PR's).
PUBLIC_KEYSTATIC_GITHUB_REPO=

# Alleen nodig voor de Keystatic admin in GitHub-modus; Keystatic helpt deze aan te maken.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# true = bouw ook de /keystatic admin mee (vereist Node-server: node dist/server/entry.mjs)
KEYSTATIC=

# Inloggen met GitHub in Sveltia (/admin/), alleen nodig op de server. Zie README.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_DOMAINS=tkkrlab.nl
