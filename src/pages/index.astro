---
import Base from '../layouts/Base.astro';
import CardGrid from '../components/CardGrid.astro';
import { getHome } from '../lib/content';

const home = await getHome();
const paragraphs = (text: string) => text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

<Base overlayHeader>
  <section class="hero">
    {home.heroImage && <img src={home.heroImage} alt="" fetchpriority="high" />}
    <div class="wrap hero-inner">
      <p class="kicker">Hackerspace Enschede</p>
      <h1>{home.heroTitle}</h1>
      {home.heroButton.href && <a class="btn" href={home.heroButton.href}>{home.heroButton.label}</a>}
    </div>
  </section>

  {
    home.sections.map((section, i) => (
      <section class:list={['split', { dark: section.dark, flip: i % 2 === 1 }]}>
        <div class="wrap split-inner">
          <div class="text">
            <h2>{section.title}</h2>
            {paragraphs(section.body).map((p) => (
              <p>
                {p.split('\n').map((line, j, all) => (
                  <>
                    {line}
                    {j < all.length - 1 && <br />}
                  </>
                ))}
              </p>
            ))}
            {section.buttons.length > 0 && (
              <div class="btn-row">
                {section.buttons.map((b, j) => (
                  <a class:list={['btn', { 'btn--ghost': j > 0 }]} href={b.href}>
                    {b.label}
                  </a>
                ))}
              </div>
            )}
          </div>
          {section.image && (
            <div class="media">
              <img src={section.image} alt="" loading="lazy" />
            </div>
          )}
        </div>
      </section>
    ))
  }

  <section class="wrap latest">
    <div class="latest-head">
      <h2>Laatste nieuws</h2>
      <a href="/blog/">Alle berichten →</a>
    </div>
    <CardGrid collection="posts" limit={3} />
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 46rem);
    display: grid;
    align-items: end;
    color: #fff;
    background: var(--ink-2);
    overflow: hidden;
  }
  .hero > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15) brightness(0.62);
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 55%;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.6));
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    padding-block: 8rem 4.5rem;
  }
  .kicker {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.8rem;
    color: var(--yellow);
    margin: 0;
  }
  .hero h1 {
    font-size: 3em;
    margin: 0.6rem 0 2rem;
  }

  .split {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }
  .split.dark {
    background: var(--ink-2);
    color: var(--paper);
  }
  .split-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .flip .media {
    order: -1;
  }
  .text h2 {
    margin-top: 0;
  }
  .text h2::before {
    content: '';
    display: block;
    width: 2.5rem;
    height: 4px;
    background: var(--yellow);
    margin-bottom: 1.25rem;
  }
  .media img {
    width: 100%;
    max-height: 34rem;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .latest {
    padding-top: 5rem;
  }
  .latest-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .latest-head h2 {
    margin: 0;
  }
  .latest :global(.cards) {
    margin-top: 1.5rem;
  }

  @media (max-width: 48rem) {
    .split-inner {
      grid-template-columns: 1fr;
    }
    .flip .media {
      order: 0;
    }
  }
</style>
