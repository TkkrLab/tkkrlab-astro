---
import Base from '../layouts/Base.astro';
---

<Base title="Niet gevonden">
  <div class="wrap nf">
    <p class="code">404</p>
    <h1>Deze pagina bestaat (nog) niet</h1>
    <p>Misschien is hij verhuisd tijdens de overstap naar de nieuwe site.</p>
    <div class="btn-row">
      <a class="btn" href="/">Naar de homepage</a>
      <a class="btn btn--ghost" href="/blog/">Blog</a>
    </div>
  </div>
</Base>

<style>
  .nf {
    padding-block: 5rem 2rem;
  }
  .code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 15vw, 9rem);
    line-height: 1;
    margin: 0;
    color: var(--ink);
    text-shadow: 0.06em 0.06em 0 var(--yellow);
  }
</style>
