---
// Sveltia CMS admin. Lives here (not public/admin/index.html) so `astro dev` serves it at /admin/.
import previewCss from '../../styles/cms-preview.css?url';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>TkkrLab CMS</title>
    <link rel="icon" href="/logo.png" type="image/png" />
  </head>
  <body>
    <!-- Pinned version; bump deliberately. -->
    <script is:inline src="https://unpkg.com/@sveltia/cms@0.227.4/dist/sveltia-cms.js"></script>
    <script is:inline src="https://unpkg.com/js-yaml@4.1.0/dist/js-yaml.min.js"></script>
    <script is:inline define:vars={{ previewCss }}>
      // Markdoc tags used in content; keep in sync with markdoc.config.mjs.
      const attr = (s) => String(s ?? '').replace(/"/g, "'");

      // Sveltia only allows `frontmatter` with .md/.markdown, so teach it .mdoc:
      // YAML front matter + Markdoc body. CORE_SCHEMA keeps dates as plain strings.
      CMS.registerCustomFormat('mdoc', 'mdoc', {
        fromFile: (text) => {
          const m = text.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
          if (!m) return { body: text };
          const data = jsyaml.load(m[1], { schema: jsyaml.CORE_SCHEMA }) ?? {};
          return { ...data, body: m[2].replace(/^\r?\n/, '') };
        },
        toFile: (data) => {
          const { body = '', ...rest } = data;
          const fm = Object.fromEntries(Object.entries(rest).filter(([, v]) => v !== undefined && v !== null && v !== ''));
          const yaml = jsyaml.dump(fm, { schema: jsyaml.CORE_SCHEMA, lineWidth: -1 });
          return `---\n${yaml}---\n\n${body.trim()}\n`;
        },
      });

      CMS.registerEditorComponent({
        id: 'button',
        label: 'Knop',
        icon: 'smart_button',
        fields: [
          { name: 'label', label: 'Tekst', widget: 'string' },
          { name: 'href', label: 'Link', widget: 'string', hint: 'Bijv. /deelnemer-worden/ of https://…' },
        ],
        pattern: /^\{% button href="([^"]*)" label="([^"]*)" \/%\}$/m,
        fromBlock: (m) => ({ href: m[1], label: m[2] }),
        toBlock: (d) => `{% button href="${attr(d.href)}" label="${attr(d.label)}" /%}`,
        toPreview: (d) => `<a class="btn" href="${attr(d.href)}">${attr(d.label)}</a>`,
      });

      CMS.registerEditorComponent({
        id: 'youtube',
        label: 'YouTube video',
        icon: 'smart_display',
        fields: [{ name: 'id', label: 'Video ID', widget: 'string', hint: 'Het stukje na watch?v= in de YouTube-URL' }],
        pattern: /^\{% youtube id="([^"]*)" \/%\}$/m,
        fromBlock: (m) => ({ id: m[1] }),
        toBlock: (d) => `{% youtube id="${attr(d.id)}" /%}`,
        toPreview: (d) => `<img src="https://i.ytimg.com/vi/${attr(d.id)}/hqdefault.jpg" alt="YouTube ${attr(d.id)}" style="max-width:100%">`,
      });

      // ---- Preview pane: render entries like the real site ------------------
      // Mirrors src/layouts/Entry.astro, src/pages/[slug].astro and index.astro.
      CMS.registerPreviewStyle(previewCss);

      const formatDate = (s) => {
        const d = new Date(s);
        return isNaN(d) ? '' : d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
      };
      const asset = (getAsset, path) => (path ? getAsset(path)?.url ?? path : null);

      const entryPreview = (backLabel, showDate = true) =>
        createClass({
          render() {
            const { entry, widgetFor, getAsset } = this.props;
            const data = (k) => entry.getIn(['data', k]);
            const cover = asset(getAsset, data('coverImage'));
            return h(
              'article',
              { className: 'wrap pv-article' },
              h('span', { className: 'pv-back' }, `← ${backLabel}`),
              h('h1', {}, data('title')),
              showDate && h('time', { className: 'pv-date' }, formatDate(data('date'))),
              cover && h('img', { className: 'pv-cover', src: cover, alt: '' }),
              h('div', { className: 'prose', style: { marginTop: '2rem' } }, widgetFor('body')),
            );
          },
        });

      CMS.registerPreviewTemplate('posts', entryPreview('Blog'));
      CMS.registerPreviewTemplate('projects', entryPreview('Projecten'));
      CMS.registerPreviewTemplate('tools', entryPreview('Werkplaats', false));
      CMS.registerPreviewTemplate('cybersaturdays', entryPreview('Cybersaturdays'));

      const listingLabels = { posts: 'blogberichten', projects: 'projecten', tools: 'gereedschap', cybersaturdays: 'Cybersaturdays' };
      CMS.registerPreviewTemplate(
        'pages',
        createClass({
          render() {
            const { entry, widgetFor } = this.props;
            const listing = entry.getIn(['data', 'listing']);
            return h(
              'div',
              { className: 'wrap pv-page' },
              h('h1', {}, entry.getIn(['data', 'title'])),
              h('div', { className: 'prose' }, widgetFor('body')),
              listingLabels[listing] && h('div', { className: 'pv-listing' }, `Hier komt automatisch het overzicht van alle ${listingLabels[listing]}.`),
            );
          },
        }),
      );

      const paragraphs = (text) =>
        String(text ?? '')
          .split(/\n\s*\n/)
          .map((p) => p.trim())
          .filter(Boolean)
          .map((p, i) => h('p', { key: i }, ...p.split('\n').flatMap((line, j) => (j ? [h('br', { key: j }), line] : [line]))));

      CMS.registerPreviewTemplate(
        'home',
        createClass({
          render() {
            const { entry, getAsset } = this.props;
            const data = entry.get('data').toJS?.() ?? {};
            const heroImage = asset(getAsset, data.heroImage);
            return h(
              'div',
              {},
              h(
                'section',
                { className: 'pv-hero' },
                heroImage && h('img', { src: heroImage, alt: '' }),
                h(
                  'div',
                  { className: 'wrap' },
                  h('p', { className: 'pv-kicker' }, 'Hackerspace Enschede'),
                  h('h1', {}, data.heroTitle),
                  data.heroButton?.label && h('a', { className: 'btn' }, data.heroButton.label),
                ),
              ),
              ...(data.sections ?? []).map((s, i) => {
                const img = asset(getAsset, s.image);
                return h(
                  'section',
                  { key: i, className: `pv-split${s.dark ? ' dark' : ''}${i % 2 ? ' flip' : ''}` },
                  h(
                    'div',
                    { className: 'wrap' },
                    h(
                      'div',
                      {},
                      h('h2', {}, s.title),
                      ...paragraphs(s.body),
                      (s.buttons ?? []).length > 0 &&
                        h('div', { className: 'btn-row' }, ...s.buttons.map((b, j) => h('a', { key: j, className: j ? 'btn btn--ghost' : 'btn' }, b.label))),
                    ),
                    img && h('div', { className: 'pv-media' }, h('img', { src: img, alt: '' })),
                  ),
                );
              }),
            );
          },
        }),
      );
    </script>
  </body>
</html>
