---
import { formatDate, getSorted, routes, type DatedCollection } from '../lib/content';

interface Props {
  collection: DatedCollection;
  limit?: number;
}
const { collection, limit } = Astro.props;
const entries = (await getSorted(collection)).slice(0, limit);
const showDate = collection !== 'tools';
---

<ul class="cards">
  {
    entries.map((entry) => (
      <li>
        <a href={`${routes[collection].base}${entry.id}/`}>
          <div class="thumb">
            {entry.data.coverImage ? (
              <img src={entry.data.coverImage} alt="" loading="lazy" />
            ) : (
              <span aria-hidden="true">{entry.data.title.slice(0, 1)}</span>
            )}
          </div>
          <div class="body">
            {showDate && <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>}
            <h3>{entry.data.title}</h3>
            {entry.data.excerpt && collection !== 'tools' && <p>{entry.data.excerpt}</p>}
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .cards {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1.5rem;
  }
  a {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    transition:
      transform 0.15s,
      box-shadow 0.15s;
  }
  a:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.08);
    border-color: var(--ink);
  }
  .thumb {
    aspect-ratio: 3 / 2;
    background: var(--ink-2);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb span {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--yellow);
  }
  .body {
    padding: 1rem 1.2rem 1.3rem;
  }
  time {
    font-size: 0.85rem;
    color: var(--muted);
  }
  h3 {
    font-size: 1.2rem;
    margin: 0.2rem 0 0.4rem;
  }
  a:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 3px;
  }
  p {
    margin: 0;
    font-size: 0.95rem;
    color: #3b3b3b;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
