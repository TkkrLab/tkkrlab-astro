---
import SpaceStatus from './SpaceStatus.astro';
import { getSettings } from '../lib/content';

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const settings = await getSettings();
const current = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && current.startsWith(href);
---

<header class:list={['site-header', { overlay }]}>
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="TkkrLab – home">
      <img src="/logo.png" alt="" width="46" height="52" />
      <span>TkkrLab</span>
    </a>
    <SpaceStatus url={settings.spaceApiUrl} />
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" /></svg>
    </button>
    <nav id="site-nav" aria-label="Hoofdmenu">
      <ul>
        {
          settings.navigation.map((item) => (
            <li class:list={{ 'has-sub': item.children.length > 0 }}>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
              {item.children.length > 0 && (
                <ul class="sub">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={isActive(child.href) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('nav-open', open);
  });
</script>

<style>
  .site-header {
    background: var(--ink-2);
    color: var(--paper);
    position: relative;
    z-index: 10;
  }
  .site-header.overlay {
    position: absolute;
    inset: 0 0 auto;
    background: linear-gradient(rgb(0 0 0 / 0.65), transparent);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.6rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .brand img {
    width: 2.6rem;
    height: auto;
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav > ul {
    display: flex;
    gap: 0.25rem;
  }
  nav a {
    display: block;
    padding: 0.5rem 0.75rem;
    text-decoration: none;
    border-radius: var(--radius);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--yellow);
  }
  .has-sub {
    position: relative;
  }
  .has-sub > a::after {
    content: '';
    display: inline-block;
    margin-left: 0.4em;
    border: 0.28em solid transparent;
    border-top-color: currentColor;
    translate: 0 0.15em;
  }
  .sub {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 13rem;
    padding: 0.4rem;
    background: var(--ink-2);
    border-top: 3px solid var(--yellow);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
    visibility: hidden;
    opacity: 0;
    translate: 0 0.25rem;
    transition: 0.15s;
  }
  .has-sub:hover .sub,
  .has-sub:focus-within .sub {
    visibility: visible;
    opacity: 1;
    translate: 0 0;
  }
  .menu-toggle {
    display: none;
    margin-left: auto;
    background: none;
    border: 0;
    color: inherit;
    padding: 0.4rem;
    cursor: pointer;
  }

  @media (max-width: 52rem) {
    .bar {
      flex-wrap: wrap;
      gap: 0.6rem;
    }
    .brand img {
      width: 2.1rem;
    }
    .menu-toggle {
      display: block;
    }
    nav {
      display: none;
      flex-basis: 100%;
      margin: 0;
    }
    :global(.nav-open) nav {
      display: block;
    }
    :global(.nav-open) .site-header.overlay {
      background: var(--ink-2);
    }
    nav > ul {
      flex-direction: column;
      padding-block: 0.5rem 1rem;
    }
    nav a {
      padding: 0.65rem 0;
      font-size: 1.15rem;
    }
    .has-sub > a::after {
      display: none;
    }
    .sub {
      position: static;
      visibility: visible;
      opacity: 1;
      translate: none;
      box-shadow: none;
      border: 0;
      border-left: 2px solid var(--yellow);
      padding: 0 0 0 1rem;
      background: none;
    }
    .sub a {
      font-size: 1rem;
      padding-block: 0.4rem;
    }
  }
</style>
